# ---------------------------------------------------------------
# Clarrence Mangena Inc. website - environment variables
# Copy to .env.local for development. Set the same names in your
# hosting dashboard (Vercel / Cloudflare) for production.
# NEVER commit real values.
# ---------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://cmincattorneys.co.za

# Optional WhatsApp business number, international format, digits only
# (e.g. 27158801882). No verified WhatsApp number was found on the existing
# website, so WhatsApp buttons stay hidden until this is set.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Form delivery (server-side only) ---------------------------------
# Forms POST to /api/contact. Until RESEND_API_KEY is set, the endpoint
# returns 503 and the form tells the visitor to call or email instead.
# No fake "success" is ever shown.
RESEND_API_KEY=
# Verified sending address on a domain verified in Resend
CONTACT_FROM_EMAIL=
# Where enquiries are delivered (the firm's inbox)
CONTACT_TO_EMAIL=info@cmincattorneys.co.za

# --- Spam protection (Cloudflare Turnstile, optional but recommended) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
